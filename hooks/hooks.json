{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','session-start.mjs')).href)\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.tsx)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Write(**/*.tsx)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Edit(**/*.jsx)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Write(**/*.jsx)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Edit(**/*.vue)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Write(**/*.vue)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Edit(**/*.svelte)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Write(**/*.svelte)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Edit(**/*.css)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Write(**/*.css)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Edit(**/*.html)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Write(**/*.html)",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','frontend-check.mjs')).href)\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
